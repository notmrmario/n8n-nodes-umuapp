{
    "name": "n8n-nodes-umuapp",
    "version": "0.2.0",
    "description": "Nodos de n8n para UMUApp (Universidad de Murcia): trigger de tareas, calificaciones, exámenes, anuncios y calendario",
    "license": "MIT",
    "homepage": "",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "notmrmario",
        "email": "nachohdgamingpro@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/notmrmario/n8n-nodes-umuapp.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"test": "n8n-node build && node test/changes.js",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/UmuappApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Umuapp/Umuapp.node.js",
            "dist/nodes/Umuapp/UmuappTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
